{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://marklayer.app/schemas/desktop-target.v1.json",
  "title": "DesktopTarget",
  "description": "Stable Windows UIA desktop annotation target in physical screen pixels (PerMonitorV2).",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "app", "windowTitle", "controlType", "name", "automationId", "ancestry", "captured", "screen"],
  "properties": {
    "kind": {
      "type": "string",
      "const": "windows-uia",
      "description": "Target adapter kind."
    },
    "app": {
      "type": "string",
      "description": "Process name without extension (e.g. Notepad, powershell)."
    },
    "windowTitle": {
      "type": "string",
      "description": "Exact top-level window title at capture time."
    },
    "appPath": {
      "type": "string",
      "description": "Optional full executable path to disambiguate processes."
    },
    "windowClass": {
      "type": "string",
      "description": "Optional Win32 window class name."
    },
    "controlType": {
      "type": "string",
      "description": "UIA ControlType.ProgrammaticName (e.g. ControlType.Button)."
    },
    "name": {
      "type": "string",
      "description": "UIA Current.Name of the target control."
    },
    "automationId": {
      "type": "string",
      "description": "UIA Current.AutomationId of the target control."
    },
    "relativeRect": {
      "description": "Annotation rectangle relative to the UIA control's top-left corner, in physical pixels.",
      "$ref": "#/definitions/physicalRect"
    },
    "ancestry": {
      "type": "array",
      "description": "Ordered UIA ancestry path from top-level window down to the target's direct parent.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["controlType", "name", "automationId"],
        "properties": {
          "controlType": { "type": "string" },
          "name": { "type": "string" },
          "automationId": { "type": "string" }
        }
      }
    },
    "captured": {
      "type": "object",
      "description": "Target rectangle in physical screen pixels and monitor DPI scale at capture time.",
      "additionalProperties": false,
      "required": ["left", "top", "width", "height", "dpr"],
      "properties": {
        "left": { "type": "number" },
        "top": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "dpr": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "screen": {
      "type": "object",
      "description": "Monitor physical dimensions and DPI scale at capture time.",
      "additionalProperties": false,
      "required": ["width", "height", "scale"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "scale": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  },
  "definitions": {
    "physicalRect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "top", "width", "height"],
      "properties": {
        "left": { "type": "number" },
        "top": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" }
      }
    }
  }
}
